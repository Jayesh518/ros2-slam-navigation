<?xml version="1.0"?>
<!-- Small 6 x 6 m test arena used to check the robot, the bridge and the sensors. Not one of the study worlds. -->
<sdf version="1.8">
  <world name="default">
    <physics name="3ms" type="ode">
      <max_step_size>0.003</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <scene><shadows>false</shadows></scene>
    <light name="sun" type="directional">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="walls">
      <static>true</static>
      <link name="link">
        <collision name="n"><pose>0 3.0 0.25 0 0 0</pose><geometry><box><size>6.1 0.1 0.5</size></box></geometry></collision>
        <visual name="n"><pose>0 3.0 0.25 0 0 0</pose><geometry><box><size>6.1 0.1 0.5</size></box></geometry><material><diffuse>0.6 0.5 0.4 1</diffuse></material></visual>
        <collision name="s"><pose>0 -3.0 0.25 0 0 0</pose><geometry><box><size>6.1 0.1 0.5</size></box></geometry></collision>
        <visual name="s"><pose>0 -3.0 0.25 0 0 0</pose><geometry><box><size>6.1 0.1 0.5</size></box></geometry><material><diffuse>0.6 0.5 0.4 1</diffuse></material></visual>
        <collision name="e"><pose>3.0 0 0.25 0 0 0</pose><geometry><box><size>0.1 6.1 0.5</size></box></geometry></collision>
        <visual name="e"><pose>3.0 0 0.25 0 0 0</pose><geometry><box><size>0.1 6.1 0.5</size></box></geometry><material><diffuse>0.6 0.5 0.4 1</diffuse></material></visual>
        <collision name="w"><pose>-3.0 0 0.25 0 0 0</pose><geometry><box><size>0.1 6.1 0.5</size></box></geometry></collision>
        <visual name="w"><pose>-3.0 0 0.25 0 0 0</pose><geometry><box><size>0.1 6.1 0.5</size></box></geometry><material><diffuse>0.6 0.5 0.4 1</diffuse></material></visual>
      </link>
    </model>
    <model name="box1">
      <static>true</static>
      <pose>1.2 0.4 0.25 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.4 0.4 0.5</size></box></geometry></collision>
        <visual name="v"><geometry><box><size>0.4 0.4 0.5</size></box></geometry><material><diffuse>0.3 0.5 0.8 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
